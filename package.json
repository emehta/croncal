{
  "name": "croncal",
  "version": "1.0.0",
  "private": true,
  "description": "A calendar with repeats, drag to move and two-way Google Calendar sync, on your own database.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node scripts/start.mjs --port 3102",
