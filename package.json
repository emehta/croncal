    "maint:check-private": "node tools/check-private.mjs",
    "maint:trim-css": "node tools/trim-css.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@supabase/supabase-js": "2.117.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "24.13.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "next": "16.3.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.6"
  },
  "overrides": {
    "eslint-plugin-react-hooks": "7.0.1"
  }
